# Copy this file to .env and fill in real values before running the server.
# Never commit your real .env file to git.

# Port the server listens on (Render sets this automatically in production)
PORT=3000

# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Public base URL used when building QR code links.
# Locally: http://localhost:3000
# On Render, after you deploy: https://your-app-name.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Supabase project connection info.
# Find both on your Supabase project's Settings -> API page.
# SUPABASE_SERVICE_KEY is the "service_role" secret key, NOT the "anon" public key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace_this_with_your_service_role_key
